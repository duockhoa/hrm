# Docker Compose settings. Copy this file to .env before running Docker Compose.
# Backend secrets and external service credentials remain in backend/.env.
MYSQL_DATABASE=hrm
MYSQL_USER=hrm
MYSQL_PASSWORD=replace_with_a_strong_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_strong_password

FRONTEND_PORT=3000
BACKEND_PORT=3012
SWAGGER_PORT=50000

# This value is embedded in the browser bundle during `docker compose build`.
# In production, set it to the externally reachable API URL (for example
# https://api.example.com), not the Docker service name.
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:3012
NEXT_PUBLIC_COOKIE_DOMAIN=
COOKIE_HTTP_ONLY=true

NEXT_PUBLIC_APP_REQUEST_URL=http://localhost:3000
NEXT_PUBLIC_APP_EBR_URL=http://localhost:3000
NEXT_PUBLIC_APP_WMS_URL=http://localhost:3000
NEXT_PUBLIC_APP_SCB_URL=http://localhost:3000
NEXT_PUBLIC_REQUIRED_APP_KEY=hrm
NEXT_PUBLIC_APP_UNAUTHORIZED_REDIRECT_URL=
