# JWT authentication (durations are in seconds)
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=60
JWT_REFRESH_EXPIRES_IN=7776000

# Backend server
PORT=3012

# Database
DATABASE_URL="mysql://username:password@localhost:3306/database_name"

# Cloudinary image upload
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# External API integration
EXTERNAL_API_URL=https://example.com/api/v1/
EXTERNAL_API_TOKEN=replace_with_external_api_token

# Password reset OTP
PASSWORD_RESET_OTP_EXPIRES_IN_MINUTES=5

# Google Apps Script API for email
APPS_SCRIPT_EMAIL_API_URL=https://script.google.com/macros/s/your_script_id/exec
APPS_SCRIPT_EMAIL_TIMEOUT_MS=30000
EMAIL_SENDER_NAME="Your App"

# Google Apps Script API for PYCLM
APPS_SCRIPT_PYCLM_API_URL=https://script.google.com/macros/s/your_script_id/exec
APPS_SCRIPT_PYCLM_TIMEOUT_MS=30000

# SCB registration numbers sync
SCB_AUTH_LOGIN_URL=https://example.com/auth/login
SCB_AUTH_USERNAME=your_username
SCB_AUTH_PASSWORD=your_password
SCB_REGISTRATION_NUMBERS_SYNC_CRON="0 */30 * * * *"
SCB_REGISTRATION_NUMBERS_LIMIT=5000
SCB_REGISTRATION_NUMBERS_API_URL=https://example.com/api/ho-so

# SAP B1
SAP_SERVICE_LAYER_URL=https://example.com/b1s/v1/
SAP_COMPANY_DB=your_company_database
SAP_USERNAME=your_username
SAP_PASSWORD=your_password
NODE_TLS_REJECT_UNAUTHORIZED=0
SESSIONTIMEOUT=29
SAP_B1_LOT_LIST_SYNC_CRON="0 */30 * * * *"
SAP_B1_PAGE_SIZE=10000
