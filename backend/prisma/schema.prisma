generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Users {
  id                                                    Int                                                   @id @default(autoincrement())
  username                                              String                                                @unique
  password                                              String
  name                                                  String
  email                                                 String?                                               @unique
  created_at                                            DateTime                                              @default(now())
  updated_at                                            DateTime                                              @default(now()) @updatedAt
  avatar                                                String?
  deleted_at                                            DateTime?
  department                                            String?
  position                                              String?
  status                                                String                                                @default("active")
  companyLeaderOf                                       Company?                                              @relation("CompanyLeader")
  contracts                                             Contracts[]
  team_lead_departments                                 Departments[]                                         @relation("Departments_team_lead_user")
  passwordResetOTPs                                     PasswordResetOTPs[]
  tokens                                                Tokens[]
  profile                                               UserProfiles?
  userRoles                                             UserRoles[]
  departmentObj                                         Departments?                                          @relation("DepartmentUsers", fields: [department], references: [name])
  approvedProductionOrderDeviations                     ProductionOrderDeviations[]                           @relation("ProductionOrderDeviationApprover")
  reportedProductionOrderDeviations                     ProductionOrderDeviations[]                           @relation("ProductionOrderDeviationReporter")
  productionOrderSamplingRequests                       ProductionOrderSamplingRequests[]
  createdProductionOrderEnvironmentChecks               ProductionOrderEnvironmentChecks[]                    @relation("ProductionOrderEnvironmentCheckCreator")
  createdProductionOrderFinishedProductSummaries        ProductionOrderFinishedProductSummaries[]             @relation("ProductionOrderFinishedProductSummaryCreator")
  createdProductionOrderDensityChecks                   ProductionOrderDensityChecks[]                        @relation("ProductionOrderDensityCheckCreator")
  createdProductionOrderSamplingRecords                 ProductionOrderSamplingRecords[]                      @relation("ProductionOrderSamplingRecordCreator")
  createdProductionOrderFriabilityChecks                ProductionOrderFriabilityChecks[]                     @relation("ProductionOrderFriabilityCheckCreator")
  createdProductionOrderSprayDoseChecks                 ProductionOrderSprayDoseChecks[]                      @relation("ProductionOrderSprayDoseCheckCreator")
  createdProductionOrderPostHomogenizationGranuleChecks ProductionOrderPostHomogenizationGranuleChecks[]      @relation("ProductionOrderPostHomogenizationGranuleCheckCreator")
  createdProductionOrderDisintegrationChecks            ProductionOrderDisintegrationChecks[]                 @relation("ProductionOrderDisintegrationCheckCreator")
  createdProductionOrderHardCapsuleLeakageChecks        ProductionOrderHardCapsuleLeakageChecks[]             @relation("ProductionOrderHardCapsuleLeakageCheckCreator")
  createdProductionOrderVolumeChecks                    ProductionOrderVolumeChecks[]                         @relation("ProductionOrderVolumeCheckCreator")
  createdProductionOrderShellWeightChecks               ProductionOrderShellWeightChecks[]                    @relation("ProductionOrderShellWeightCheckCreator")
  createdProductionOrderTenShellWeightChecks            ProductionOrderTenShellWeightChecks[]                 @relation("ProductionOrderTenShellWeightCheckCreator")
  createdProductionOrderVialInspectionChecks            ProductionOrderVialInspectionChecks[]                 @relation("ProductionOrderVialInspectionCheckCreator")
  createdProductionOrderCylinderCalibrations            ProductionOrderCylinderCalibrations[]                 @relation("ProductionOrderCylinderCalibrationCreator")
  createdProductionOrderSensoryChecks                   ProductionOrderSensoryChecks[]                        @relation("ProductionOrderSensoryCheckCreator")
  createdProductionOrderDateChecks                      ProductionOrderDateChecks[]                           @relation("ProductionOrderDateCheckCreator")
  approvedProductionOrderDateChecks                     ProductionOrderDateChecks[]                           @relation("ProductionOrderDateCheckApprover")
  createdProductionOrderDateCheckImages                 ProductionOrderDateCheckImages[]                      @relation("ProductionOrderDateCheckImageCreator")
  createdProductionWorkshopPressureDifferentials        ProductionWorkshopPressureDifferentials[]             @relation("ProductionWorkshopPressureDifferentialCreator")
  createdProductionOrderDisinfectantPreparations        ProductionOrderDisinfectantPreparations[]             @relation("ProductionOrderDisinfectantPreparationCreator")
  createdProductionOrderSteamSterilizationChecks        ProductionOrderSteamSterilizationChecks[]             @relation("ProductionOrderSteamSterilizationCheckCreator")
  checkedProductionOrderSteamSterilizationChecks        ProductionOrderSteamSterilizationChecks[]             @relation("ProductionOrderSteamSterilizationCheckChecker")
  createdProductionOrderSemiFinishedGrossWeightChecks   ProductionOrderSemiFinishedProductGrossWeightChecks[] @relation("ProductionOrderSemiFinishedGrossWeightCheckCreator")
  createdProductionOrderSemiFinishedNetWeightChecks     ProductionOrderSemiFinishedProductNetWeightChecks[]   @relation("ProductionOrderSemiFinishedNetWeightCheckCreator")
  createdProductionOrderSemiFinishedProductSummaries    ProductionOrderSemiFinishedProductSummaries[]         @relation("ProductionOrderSemiFinishedProductSummaryCreator")
  createdProductionOrderLeakTightnessChecks             ProductionOrderLeakTightnessChecks[]                  @relation("ProductionOrderLeakTightnessCheckCreator")
  createdProductionOrderTenUnitSensoryChecks            ProductionOrderTenUnitSensoryChecks[]                 @relation("ProductionOrderTenUnitSensoryCheckCreator")
  checkedProductionOrderPostPreparationSolutionChecks   ProductionOrderPostPreparationSolutionChecks[]        @relation("ProductionOrderPostPreparationSolutionCheckChecker")
  approvedProductionOrderFactoryReleaseReviews          ProductionOrderFactoryReleaseReviews[]                @relation("ProductionOrderFactoryReleaseReviewApprover")

  @@index([department], map: "users_department_fkey")
  @@map("users")
}

model UserProfiles {
  id         Int       @id @default(autoincrement())
  user_id    Int       @unique
  id_card    String?   @unique
  birth_date DateTime?
  phone      String?   @unique
  address    String?
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now()) @updatedAt
  users      Users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Tokens {
  id           Int      @id @default(autoincrement())
  user_id      Int
  refreshToken String   @unique @db.VarChar(512)
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt
  users        Users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "tokens_user_id_fkey")
  @@map("tokens")
}

model Roles {
  id              Int               @id @default(autoincrement())
  name            String            @unique
  description     String?
  created_at      DateTime          @default(now())
  updated_at      DateTime          @default(now()) @updatedAt
  deleted_at      DateTime?
  rolePermissions RolePermissions[]
  userRoles       UserRoles[]

  @@map("roles")
}

model UserRoles {
  id         Int      @id @default(autoincrement())
  user_id    Int
  role_id    Int
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
  roles      Roles    @relation(fields: [role_id], references: [id], onDelete: Cascade)
  users      Users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([role_id], map: "user_roles_role_id_fkey")
  @@index([user_id], map: "user_roles_user_id_fkey")
  @@map("user_roles")
}

model Permissions {
  id              Int               @id @default(autoincrement())
  name            String            @unique
  description     String?
  created_at      DateTime          @default(now())
  updated_at      DateTime          @default(now()) @updatedAt
  rolePermissions RolePermissions[]

  @@map("permissions")
}

model RolePermissions {
  id            Int         @id @default(autoincrement())
  role_id       Int
  permission_id Int
  created_at    DateTime    @default(now())
  updated_at    DateTime    @default(now()) @updatedAt
  permissions   Permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade)
  roles         Roles       @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@index([permission_id], map: "role_permissions_permission_id_fkey")
  @@index([role_id], map: "role_permissions_role_id_fkey")
  @@map("role_permissions")
}

model Departments {
  name           String    @id @unique
  description    String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @default(now()) @updatedAt
  team_lead      Int?
  company_id     Int?
  deleted_at     DateTime?
  company        Company?  @relation(fields: [company_id], references: [id])
  team_lead_user Users?    @relation("Departments_team_lead_user", fields: [team_lead], references: [id])
  users          Users[]   @relation("DepartmentUsers")

  @@index([company_id], map: "departments_company_id_fkey")
  @@index([team_lead], map: "departments_team_lead_fkey")
  @@map("departments")
}

model Contracts {
  id         Int             @id @default(autoincrement())
  title      String
  content    String
  type       String
  user_id    Int
  start_date DateTime
  end_date   DateTime
  status     String          @default("active")
  created_at DateTime        @default(now())
  updated_at DateTime        @default(now()) @updatedAt
  files      ContractFiles[]
  users      Users           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "contracts_user_id_fkey")
  @@map("contracts")
}

model ContractFiles {
  id          Int       @id @default(autoincrement())
  contract_id Int
  file_path   String
  created_at  DateTime  @default(now())
  updated_at  DateTime  @default(now()) @updatedAt
  contracts   Contracts @relation(fields: [contract_id], references: [id], onDelete: Cascade)

  @@index([contract_id], map: "contract_files_contract_id_fkey")
  @@map("contract_files")
}

model Company {
  id          Int           @id @default(autoincrement())
  name        String        @unique
  address     String?
  phone       String?
  email       String?       @unique
  created_at  DateTime      @default(now())
  updated_at  DateTime      @default(now()) @updatedAt
  deleted_at  DateTime?
  description String?
  leader_id   Int?          @unique
  leader      Users?        @relation("CompanyLeader", fields: [leader_id], references: [id])
  departments Departments[]

  @@map("company")
}

model PasswordResetOTPs {
  id         Int       @id @default(autoincrement())
  user_id    Int
  hash_OTP   String    @unique @db.VarChar(512)
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())
  user       Users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "password_reset_otps_user_id_fkey")
  @@map("password_reset_otps")
}

model RegistrationNumbers {
  id                  Int       @id @default(autoincrement())
  registration_number String    @unique
  created_at          DateTime  @default(now())
  updated_at          DateTime  @default(now()) @updatedAt
  deleted_at          DateTime?
  items               Items[]

  @@map("registration_numbers")
}

model Items {
  item_code               String                    @id
  item_name               String                    @db.Text
  unit                    String?
  dk_code                 String?
  registration_id         Int?
  registration            RegistrationNumbers?      @relation(fields: [registration_id], references: [id])
  itemFeatures            ItemFeatures[]
  productionOrders        ProductionOrders[]
  productionSpecification ProductionSpecifications?
  created_at              DateTime                  @default(now())
  update_at               DateTime                  @default(now()) @updatedAt
  deleted_at              DateTime?

  @@map("items")
}

model Features {
  id            Int            @id @default(autoincrement())
  key           String         @unique
  kind          String
  label         String
  default_order Int            @default(0)
  created_at    DateTime       @default(now())
  updated_at    DateTime       @default(now()) @updatedAt
  itemFeatures  ItemFeatures[]

  @@map("features")
}

model ItemFeatures {
  id         Int      @id @default(autoincrement())
  item_code  String
  feature_id Int
  enabled    Boolean  @default(true)
  order      Int?
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
  item       Items    @relation(fields: [item_code], references: [item_code], onDelete: Cascade)
  feature    Features @relation(fields: [feature_id], references: [id], onDelete: Cascade)

  @@unique([item_code, feature_id])
  @@index([feature_id], map: "item_features_feature_id_fkey")
  @@index([item_code], map: "item_features_item_code_fkey")
  @@map("item_features")
}

model ProductLines {
  id                       Int                        @id @default(autoincrement())
  code                     String                     @unique
  name                     String
  created_at               DateTime                   @default(now())
  updated_at               DateTime                   @default(now()) @updatedAt
  productionSpecifications ProductionSpecifications[]

  @@map("product_lines")
}

model ProductionWorkshops {
  id                       Int                                       @id @default(autoincrement())
  code                     String                                    @unique @db.VarChar(50)
  name                     String
  description              String?                                   @db.Text
  address                  String?
  created_at               DateTime                                  @default(now())
  updated_at               DateTime                                  @default(now()) @updatedAt
  deleted_at               DateTime?
  pressureDifferentials    ProductionWorkshopPressureDifferentials[]
  disinfectantPreparations ProductionOrderDisinfectantPreparations[]

  @@map("production_workshops")
}

model ProductionWorkshopPressureDifferentials {
  id                    Int                 @id @default(autoincrement())
  workshop_id           Int
  workshop              ProductionWorkshops @relation(fields: [workshop_id], references: [id], onDelete: Cascade, map: "pw_pressure_diff_workshop_id_fkey")
  gauge_name            String
  differential_pressure Int
  unit                  String              @default("Pa") @db.VarChar(20)
  conclusion            String              @db.VarChar(50)
  created_by_id         Int
  createdBy             Users               @relation("ProductionWorkshopPressureDifferentialCreator", fields: [created_by_id], references: [id], map: "pw_pressure_diff_created_by_id_fkey")
  created_at            DateTime            @default(now())
  updated_at            DateTime            @default(now()) @updatedAt

  @@index([workshop_id], map: "pw_pressure_diff_workshop_id_fkey")
  @@index([created_by_id], map: "pw_pressure_diff_created_by_id_fkey")
  @@map("production_workshop_pressure_differentials")
}

model ProductionOrders {
  id                                   Int                                                   @id
  item_code                            String
  item                                 Items                                                 @relation(fields: [item_code], references: [item_code])
  status                               String
  type                                 String
  planned_quatity                      Int
  creation_date                        DateTime
  origin                               String?
  warehouse                            String?
  unit                                 String
  start_date                           DateTime
  description                          String
  date_manufacture                     String?
  expire_date                          String?
  lot_no                               String
  packing_specification                String?
  production_order_code                String?
  remarks                              String?                                               @db.Text
  internal_notes                       String?                                               @db.Text
  deviations                           ProductionOrderDeviations[]
  samplingRequests                     ProductionOrderSamplingRequests[]
  environmentChecks                    ProductionOrderEnvironmentChecks[]
  finishedProductSummaries             ProductionOrderFinishedProductSummaries[]
  densityChecks                        ProductionOrderDensityChecks[]
  samplingRecords                      ProductionOrderSamplingRecords[]
  friabilityChecks                     ProductionOrderFriabilityChecks[]
  sprayDoseChecks                      ProductionOrderSprayDoseChecks[]
  postHomogenizationGranuleChecks      ProductionOrderPostHomogenizationGranuleChecks[]
  disintegrationChecks                 ProductionOrderDisintegrationChecks[]
  hardCapsuleLeakageChecks             ProductionOrderHardCapsuleLeakageChecks[]
  volumeChecks                         ProductionOrderVolumeChecks[]
  shellWeightChecks                    ProductionOrderShellWeightChecks[]
  tenShellWeightCheck                  ProductionOrderTenShellWeightChecks?
  semiFinishedProductGrossWeightChecks ProductionOrderSemiFinishedProductGrossWeightChecks[]
  semiFinishedProductNetWeightChecks   ProductionOrderSemiFinishedProductNetWeightChecks[]
  semiFinishedProductSummaries         ProductionOrderSemiFinishedProductSummaries[]
  leakTightnessChecks                  ProductionOrderLeakTightnessChecks[]
  tenUnitSensoryChecks                 ProductionOrderTenUnitSensoryChecks[]
  vialInspectionChecks                 ProductionOrderVialInspectionChecks[]
  cylinderCalibration                  ProductionOrderCylinderCalibrations?
  sensoryChecks                        ProductionOrderSensoryChecks[]
  dateChecks                           ProductionOrderDateChecks[]
  disinfectantPreparations             ProductionOrderDisinfectantPreparations[]
  steamSterilizationChecks             ProductionOrderSteamSterilizationChecks[]
  postPreparationSolutionChecks        ProductionOrderPostPreparationSolutionChecks[]
  factoryReleaseReviews                ProductionOrderFactoryReleaseReviews[]

  @@index([item_code], map: "production_orders_item_code_fkey")
  @@map("production_orders")
}

model ProductionOrderFactoryReleaseReviews {
  id                            Int              @id @default(autoincrement())
  production_order_id           Int
  productionOrder               ProductionOrders @relation(fields: [production_order_id], references: [id], onDelete: Cascade, map: "po_factory_release_reviews_po_id_fkey")
  approved_by_id                Int?
  approvedBy                    Users?           @relation("ProductionOrderFactoryReleaseReviewApprover", fields: [approved_by_id], references: [id], map: "po_factory_release_reviews_approved_by_id_fkey")
  registration_number           String
  raw_material_test_result      String?          @db.Text
  water_test_result             String?          @db.Text
  compressed_air_test_result    String?          @db.Text
  filter_integrity_test_result  String?          @db.Text
  packaging_inspection_result   String?          @db.Text
  finished_product_test_result  String?          @db.Text
  sterilization_result          String?          @db.Text
  online_particle_result        String?          @db.Text
  yield_quantity                String?          @db.Text
  deviation                     String?          @db.Text
  environment_monitoring_result String?          @db.Text
  created_at                    DateTime         @default(now())
  updated_at                    DateTime         @default(now()) @updatedAt

  @@index([production_order_id], map: "po_factory_release_reviews_po_id_fkey")
  @@index([approved_by_id], map: "po_factory_release_reviews_approved_by_id_fkey")
  @@map("production_order_factory_release_reviews")
}

model ProductionSpecifications {
  item_code                                     String        @id
  item                                          Items         @relation(fields: [item_code], references: [item_code])
  product_line_id                               Int?
  productLine                                   ProductLines? @relation(fields: [product_line_id], references: [id], onDelete: SetNull)
  dosage_form                                   String?
  lower_control_limit                           Decimal?      @db.Decimal(18, 6)
  upper_control_limit                           Decimal?      @db.Decimal(18, 6)
  lower_allowed_limit                           Decimal?      @db.Decimal(18, 6)
  upper_allowed_limit                           Decimal?      @db.Decimal(18, 6)
  unit                                          String?
  spray_dose_lower_allowed_limit                Decimal?      @db.Decimal(18, 6)
  spray_dose_upper_allowed_limit                Decimal?      @db.Decimal(18, 6)
  spray_dose_lower_control_limit                Decimal?      @db.Decimal(18, 6)
  spray_dose_upper_control_limit                Decimal?      @db.Decimal(18, 6)
  film_coated_tablet_weight_lower_control_limit Decimal?      @db.Decimal(18, 6)
  film_coated_tablet_weight_upper_control_limit Decimal?      @db.Decimal(18, 6)
  film_coated_tablet_weight_lower_allowed_limit Decimal?      @db.Decimal(18, 6)
  film_coated_tablet_weight_upper_allowed_limit Decimal?      @db.Decimal(18, 6)
  film_coated_tablet_weight_unit                String?       @db.VarChar(20)
  created_at                                    DateTime      @default(now())
  updated_at                                    DateTime      @default(now()) @updatedAt
  deleted_at                                    DateTime?

  @@index([product_line_id], map: "production_specifications_product_line_id_fkey")
  @@map("production_specifications")
}

model ProductionOrderDeviations {
  id                  Int                              @id @default(autoincrement())
  production_order_id Int
  productionOrder     ProductionOrders                 @relation(fields: [production_order_id], references: [id], onDelete: Cascade)
  deviation_content   String                           @db.Text
  handling_plan       String                           @db.Text
  approver_id         Int?
  approver            Users?                           @relation("ProductionOrderDeviationApprover", fields: [approver_id], references: [id])
  reporter_id         Int
  reporter            Users                            @relation("ProductionOrderDeviationReporter", fields: [reporter_id], references: [id])
  images              ProductionOrderDeviationImages[]
  created_at          DateTime                         @default(now())
  updated_at          DateTime                         @default(now()) @updatedAt
  deleted_at          DateTime?

  @@index([production_order_id], map: "production_order_deviations_production_order_id_fkey")
  @@index([approver_id], map: "production_order_deviations_approver_id_fkey")
  @@index([reporter_id], map: "production_order_deviations_reporter_id_fkey")
  @@map("production_order_deviations")
}

model ProductionOrderDeviationImages {
  id           Int                       @id @default(autoincrement())
  deviation_id Int
  deviation    ProductionOrderDeviations @relation(fields: [deviation_id], references: [id], onDelete: Cascade)
  image_path   String                    @db.Text
  created_at   DateTime                  @default(now())
  updated_at   DateTime                  @default(now()) @updatedAt
  deleted_at   DateTime?

  @@index([deviation_id], map: "production_order_deviation_images_deviation_id_fkey")
  @@map("production_order_deviation_images")
}

model ProductionOrderSamplingRequests {
  id                  Int              @id @default(autoincrement())
  production_order_id Int
  productionOrder     ProductionOrders @relation(fields: [production_order_id], references: [id], onDelete: Cascade)
  sender_id           Int?
  sender              Users?           @relation(fields: [sender_id], references: [id])
  location            String?
  google_doc_url      String?          @db.Text
  status              String           @default("sent")
  sent_at             DateTime         @default(now())
  created_at          DateTime         @default(now())
  updated_at          DateTime         @default(now()) @updatedAt

  @@index([production_order_id], map: "production_order_sampling_requests_production_order_id_fkey")
  @@index([sender_id], map: "production_order_sampling_requests_sender_id_fkey")
  @@map("production_order_sampling_requests")
}

model ProductionOrderEnvironmentChecks {
  id                  Int              @id @default(autoincrement())
  production_order_id Int
  productionOrder     ProductionOrders @relation(fields: [production_order_id], references: [id], onDelete: Cascade)
  room                String
  temperature_c       Decimal          @db.Decimal(5, 2)
  humidity_percent    Decimal          @db.Decimal(5, 2)
  created_by_id       Int
  createdBy           Users            @relation("ProductionOrderEnvironmentCheckCreator", fields: [created_by_id], references: [id])
  checked_at          DateTime
  created_at          DateTime         @default(now())
  updated_at          DateTime         @default(now()) @updatedAt

  @@index([production_order_id], map: "production_order_environment_checks_production_order_id_fkey")
  @@index([created_by_id], map: "production_order_environment_checks_created_by_id_fkey")
  @@map("production_order_environment_checks")
}

model ProductionOrderFinishedProductSummaries {
  id                  Int              @id @default(autoincrement())
  production_order_id Int
  productionOrder     ProductionOrders @relation(fields: [production_order_id], references: [id], onDelete: Cascade, map: "po_finished_summary_po_id_fkey")
  package_count       Int
  boxes_per_package   Int
  loose_box_count     Int
  created_by_id       Int
  createdBy           Users            @relation("ProductionOrderFinishedProductSummaryCreator", fields: [created_by_id], references: [id], map: "po_finished_summary_created_by_id_fkey")
  created_at          DateTime         @default(now())
  updated_at          DateTime         @default(now()) @updatedAt

  @@index([production_order_id], map: "po_finished_summary_po_id_fkey")
  @@index([created_by_id], map: "po_finished_summary_created_by_id_fkey")
  @@map("production_order_finished_product_summaries")
}

model ProductionOrderDensityChecks {
  id                         Int              @id @default(autoincrement())
  production_order_id        Int
  productionOrder            ProductionOrders @relation(fields: [production_order_id], references: [id], onDelete: Cascade, map: "po_density_checks_po_id_fkey")
  empty_pycnometer_mass_g    Decimal          @db.Decimal(12, 4)
  solution_pycnometer_mass_g Decimal          @db.Decimal(12, 4)
  water_pycnometer_mass_g    Decimal          @db.Decimal(12, 4)
  density                    Decimal          @db.Decimal(12, 6)
  created_by_id              Int
  createdBy                  Users            @relation("ProductionOrderDensityCheckCreator", fields: [created_by_id], references: [id], map: "po_density_checks_created_by_id_fkey")
  created_at                 DateTime         @default(now())
  updated_at                 DateTime         @default(now()) @updatedAt

  @@index([production_order_id], map: "po_density_checks_po_id_fkey")
  @@index([created_by_id], map: "po_density_checks_created_by_id_fkey")
  @@map("production_order_density_checks")
}

model ProductionOrderSamplingRecords {
  id                  Int              @id @default(autoincrement())
  production_order_id Int
  productionOrder     ProductionOrders @relation(fields: [production_order_id], references: [id], onDelete: Cascade, map: "po_sampling_records_po_id_fkey")
  sampling_type       String           @db.VarChar(100)
  quantity            Decimal          @db.Decimal(12, 2)
  unit                String           @db.VarChar(50)
  created_by_id       Int
  createdBy           Users            @relation("ProductionOrderSamplingRecordCreator", fields: [created_by_id], references: [id], map: "po_sampling_records_created_by_id_fkey")
  created_at          DateTime         @default(now())
  updated_at          DateTime         @default(now()) @updatedAt

  @@index([production_order_id], map: "po_sampling_records_po_id_fkey")
  @@index([created_by_id], map: "po_sampling_records_created_by_id_fkey")
  @@map("production_order_sampling_records")
}

model ProductionOrderDisinfectantPreparations {
  id                     Int                 @id @default(autoincrement())
  production_order_id    Int
  productionOrder        ProductionOrders    @relation(fields: [production_order_id], references: [id], onDelete: Cascade, map: "po_disinfectant_preps_po_id_fkey")
  workshop_id            Int
  workshop               ProductionWorkshops @relation(fields: [workshop_id], references: [id], map: "po_disinfectant_preps_workshop_id_fkey")
  disinfectant_name      String              @db.VarChar(255)
  purpose                String              @db.Text
  base_material_name     String              @db.VarChar(255)
  base_material_content  Decimal             @db.Decimal(10, 4)
  base_material_amount_l Decimal             @db.Decimal(12, 4)
  prepared_volume_l      Decimal             @db.Decimal(12, 4)
